# Configuración de variables de entorno para Level-Up Gamer (Backend Spring Boot)
# Copia este archivo a .env o configúralas en tu entorno antes de arrancar

# Clave secreta para firma HMAC-SHA256 de tokens JWT (Obligatoria, mínimo 32 caracteres / 256 bits)
JWT_SECRET=ClaveSecretaSuperSeguraNivelGamerFullstack2026DuocUCJWT!RotadaV2

# Tiempo de vida de Access Token en milisegundos (ej: 900000 = 15 minutos)
JWT_EXPIRATION=900000

# Tiempo de vida de Refresh Token en milisegundos (ej: 604800000 = 7 días)
JWT_REFRESH_EXPIRATION=604800000

# Orígenes CORS permitidos (separados por coma)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Perfil activo de Spring Boot (dev habilita consola H2 en /h2-console; prod la deshabilita)
SPRING_PROFILES_ACTIVE=dev
